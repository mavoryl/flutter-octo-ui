# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.buildlog/
.history
.svn/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
# Libraries should not include pubspec.lock, per https://dart.dev/guides/libraries/private-files#pubspeclock.
/pubspec.lock
**/doc/api/
.dart_tool/
.flutter-plugins-dependencies
/build/
/coverage/
/docs/
/CLAUDE.md
/.claude/

# golden_matrix CI reports — generated only under isCiEnvironment, uploaded
# as artifacts by GitHub Actions; never committed.
test/goldens/**/*_report.xml
test/goldens/**/*_report.html
test/goldens/**/*_report.md
test/goldens/**/*_report.json

# golden_matrix failure artifacts — diff / master / test PNGs written when
# a comparison fails locally. Uploaded as CI artifacts only.
test/goldens/**/failures/

# Token generator build output (the root `/build/` pattern is anchored).
tools/octo_tokens_gen/build/
